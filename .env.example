RTSP_URL=rtsp://user:pass@192.168.1.X:554/stream1

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

TANY_MCP_URL=
TANY_API_KEY=

# capture-svc clap detector — defaults below, tune per room/mic if
# double-claps aren't triggering (see capture-svc/clap_detector.py).
# CLAP_MAX_MS is what tells a real clap (a short transient) apart from
# talking/background noise at similar volume (sustained) — raise it if
# real claps are being rejected as "too long", lower it if quieter
# background chatter is still slipping through as false triggers
# CLAP_ENERGY_THRESHOLD=0.35
# CLAP_WINDOW_MS=600
# CLAP_REFRACTORY_MS=250
# CLAP_MAX_MS=60

# orchestrator end-of-utterance detector — a normal speaking voice only
# registers ~0.01-0.02 RMS on a laptop mic (much quieter than a clap),
# so keep this low or it may never detect speech starting at all;
# raise it only if ambient noise is making replies take forever
# ENDPOINT_ENERGY_THRESHOLD=0.008
# ENDPOINT_SILENCE_MS=700
